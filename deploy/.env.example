# Скопируйте в deploy/.env и поменяйте значения. Секреты не коммитятся.
POSTGRES_DB=tirestock
POSTGRES_USER=tirestock
POSTGRES_PASSWORD=tirestock
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=3000

# Доставка заявок. Приоритет: мост через старый сайт → прямой tradesk → мок.
# Вариант 1 (сейчас): мост через /ajax/call.php Битрикса на период параллельного запуска.
OLDSITE_BASE_URL=https://tirestock.ru
# Вариант 2 (в итоге): прямой приёмник tradesk. Заполнять после вскрытия механизма;
# секреты — в deploy/.env, не в .env.example.
TRADESK_BASE_URL=
TRADESK_USERNAME=
TRADESK_PASSWORD=

# Первый пользователь админки — создаётся при старте, ТОЛЬКО если таблица пуста.
# После первого входа смените пароль/заведите остальных; секреты — в deploy/.env.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Виталий

# Синк каталога из SelectTyres. Единый фид (ассортимент + остатки) — JSON по ссылке
# с токеном (сам URL = секрет). Пусто → каталог остаётся на моке.
SELECTYRES_FEED_URL=
SELECTYRES_SYNC_INTERVAL=1h
