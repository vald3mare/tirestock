# Прод-конфиг TireStock (Yandex Cloud). Скопировать в infra/.env.prod и заполнить.
# .env.prod НЕ коммитить (секреты) — он в .gitignore.

# Домен витрины (A-запись → публичный IP VM). На нём Traefik выпустит TLS.
DOMAIN=demo.example.ru
# Почта для Let's Encrypt (уведомления об истечении сертификата).
ACME_EMAIL=admin@example.ru

# Managed PostgreSQL (Yandex Cloud): строка из консоли кластера.
# Формат: postgres://<user>:<pass>@<host>:6432/<db>?sslmode=require
# Верификация CA (надёжнее): sslmode=verify-full + смонтировать CA — см. README.
DATABASE_URL=postgres://tirestock:CHANGE_ME@rc1a-xxxxxxxx.mdb.yandexcloud.net:6432/tirestock?sslmode=require

# Индексация поисковиками: true на боевом домене, false на тестовом.
SITE_INDEXABLE=true

# Доставка заказов/заявок — боевой tradesk.
TRADESK_BASE_URL=http://tradesk.ru
TRADESK_USERNAME=
TRADESK_PASSWORD=

# Синк каталога SelectTyres (URL фида = секрет; уточняется у поставщика).
SELECTYRES_FEED_URL=
SELECTYRES_WHEELS_FEED_URL=
SELECTYRES_PHOTO_FEED_URL=
SELECTYRES_SYNC_INTERVAL=1h
SELECTYRES_MIN_HEALTHY_RATIO=0.5
SELECTYRES_STOCK_SPB=spb,sankt-peterburg
SELECTYRES_STOCK_MSK=moskva,moscow,mosobl,domodedovo,davydovo

# Первый пользователь админки (создаётся при пустой таблице; потом сменить пароль).
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME
ADMIN_BOOTSTRAP_NAME=Виталий
